<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>BilimGo - Categories</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
        body { background-color: #0f1026; color: #ffffff; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .phone-container { width: 390px; height: 844px; background-color: #0f1026; border-radius: 40px; box-shadow: 0 20px 40px rgba(0,0,0,0.5); overflow: hidden; display: flex; flex-direction: column; position: relative; border: 8px solid #2a2b4e; }
        .status-bar { display: flex; justify-content: space-between; padding: 14px 24px; font-size: 14px; font-weight: 600; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; }
        .content { flex: 1; overflow-y: auto; padding: 0 24px 24px 24px; }
        .bottom-nav { display: flex; justify-content: space-around; background: #181938; padding: 14px 0; border-top: 1px solid rgba(255,255,255,0.05); }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: #6b7280; font-size: 11px; text-decoration: none; }
        .nav-item.active { color: #8b5cf6; }
    </style>
</head>
<body>
    <div class="phone-container">
        <div class="status-bar"><span>9:41</span><span>📶 🔋</span></div>
        <div class="header">
            <a href="home.html" style="color: white; text-decoration: none; font-size: 18px;">←</a>
            <h3 style="font-size: 16px; font-weight: 700;">A1 Level</h3>
            <span>⚙️</span>
        </div>
        <div class="content">
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div class="category-item" style="background: #181938; padding: 14px 16px; border-radius: 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 14px;">
                        <span style="font-size: 24px; background: rgba(59, 130, 246, 0.2); padding: 10px; border-radius: 12px;">💼</span>
                        <div>
                            <h4 style="font-size: 14px; font-weight: bold;">Jobs & Occupations</h4>
                            <p style="font-size: 11px; color: #9ca3af; margin-top: 2px;">24/24 words</p>
                        </div>
                    </div>
                    <span style="color: #4b5563;">›</span>
                </div>
            </div>
        </div>
        <div class="bottom-nav">
            <a href="home.html" class="nav-item">🏠<span>Home</span></a>
            <a href="categories.html" class="nav-item active">📚<span>Learn</span></a>
            <a href="#" class="nav-item">⚡<span>Challenges</span></a>
            <a href="profile.html" class="nav-item">👤<span>Profile</span></a>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const items = document.querySelectorAll('.category-item');
            items.forEach(item => {
                item.addEventListener('click', () => {
                    alert("Tanlangan kategoriya bo'yicha so'zlar ochilmoqda...");
                });
            });
        });
    </script>
</body>
</html>
