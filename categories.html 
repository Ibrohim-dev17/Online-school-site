<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BilimGo - Categories</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', -apple-system, sans-serif; }
        body { background-color: #0f1026; color: #ffffff; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .app-container { width: 100%; max-width: 420px; height: 100vh; max-height: 900px; background-color: #0f1026; display: flex; flex-direction: column; position: relative; overflow: hidden; }
        .header { display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; }
        .back-btn { color: white; text-decoration: none; font-size: 20px; display: flex; align-items: center; }
        .header-title { font-size: 16px; font-weight: 700; }
        .content { flex: 1; overflow-y: auto; padding: 0 24px 24px 24px; }
        .content::-webkit-scrollbar { display: none; }
        .cat-list { display: flex; flex-direction: column; gap: 12px; }
        .cat-item { background: #181938; border: 1px solid rgba(255,255,255,0.05); padding: 16px; border-radius: 18px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: 0.2s; }
        .cat-item:hover { border-color: #8b5cf6; background: #20224d; }
        .cat-left { display: flex; align-items: center; gap: 14px; }
        .cat-icon { width: 44px; height: 44px; background: rgba(59, 130, 246, 0.15); border-radius: 14px; display: flex; justify-content: center; align-items: center; }
        .cat-icon svg { width: 22px; height: 22px; fill: #3b82f6; }
        .cat-title { font-size: 15px; font-weight: bold; margin-bottom: 2px; }
        .cat-sub { font-size: 12px; color: #9ca3af; }
        .arrow { color: #4b5563; font-size: 18px; }
        .bottom-nav { display: flex; justify-content: space-around; background: #151632; padding: 12px 0 20px 0; border-top: 1px solid rgba(255,255,255,0.05); }
        .nav-item { display: flex; flex-direction: column; align-items: center; gap: 4px; color: #6b7280; font-size: 11px; text-decoration: none; }
        .nav-item.active { color: #8b5cf6; }
        .nav-item svg { width: 22px; height: 22px; fill: currentColor; }
    </style>
</head>
<body>
    <div class="app-container">
        <div class="header">
            <a href="home.html" class="back-btn">←</a>
            <div class="header-title">A1 Level</div>
            <svg style="width:20px;height:20px;fill:#9ca3af;" viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
        </div>
        
        <div class="content">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <span style="font-size: 13px; color: #9ca3af;">Categories</span>
                <span style="font-size: 12px; color: #10b981; font-weight: bold;">Easy → Hard</span>
            </div>
            
            <div class="cat-list">
                <div class="cat-item" onclick="alert('Jobs & Occupations')">
                    <div class="cat-left">
                        <div class="cat-icon">
                            <svg viewBox="0 0 24 24"><path d="M20 6h-4V4c0-1.1-.9-2-2-2h-4c-1.1 0-2 .9-2 2v2H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zM10 4h4v2h-4V4zm10 15H4V8h16v11z"/></svg>
                        </div>
                        <div>
                            <div class="cat-title">Jobs & Occupations</div>
                            <div class="cat-sub">24/24 words</div>
                        </div>
                    </div>
                    <div class="arrow">›</div>
                </div>

                <div class="cat-item" onclick="alert('Fruits')">
                    <div class="cat-left">
                        <div class="cat-icon" style="background: rgba(236, 72, 153, 0.15);">
                            <svg viewBox="0 0 24 24" style="fill:#ec4899;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                        </div>
                        <div>
                            <div class="cat-title">Fruits</div>
                            <div class="cat-sub">18/24 words</div>
                        </div>
                    </div>
                    <div class="arrow">›</div>
                </div>
            </div>
        </div>

        <div class="bottom-nav">
            <a href="home.html" class="nav-item">
                <svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Home</span>
            </a>
            <a href="categories.html" class="nav-item active">
                <svg viewBox="0 0 24 24"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/></svg>
                <span>Learn</span>
            </a>
            <a href="#" class="nav-item">
                <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                <span>Challenges</span>
            </a>
            <a href="profile.html" class="nav-item">
                <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                <span>Profile</span>
            </a>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            console.log("Categories loaded");
        });
    </script>
</body>
</html>
